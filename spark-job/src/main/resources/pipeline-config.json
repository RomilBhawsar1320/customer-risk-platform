{
  "datasets": [
    {
      "name": "customer",
      "path": "../sample-data/customer_master.csv"
    },
    {
      "name": "bureau",
      "path": "../sample-data/credit_bureau.csv"
    },
    {
      "name": "transaction",
      "path": "../sample-data/transaction_summary.csv"
    },
    {
      "name": "product",
      "path": "../sample-data/product_holdings.csv"
    },
    {
      "name": "marketing",
      "path": "../sample-data/marketing_preferences.csv"
    }
  ],

  "output": {
    "path": "target/customer-risk-spark-output"
  },

  "joins": [
    {
      "left": "customer",
      "right": "bureau",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "transaction",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "product",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "marketing",
      "column": "customer_id",
      "type": "left"
    }
  ],

  "filters": [
    {
      "name": "good_bureau",
      "condition": "credit_score > 700"
    }
  ],

  "attributeRules": {

    "incomeBand": {
      "HIGH": "income >= 100000",
      "MEDIUM": "income >= 50000 AND income < 100000",
      "LOW": "income < 50000"
    },

    "customerSegment": {
      "PREMIUM": "income >= 150000",
      "STANDARD": "income >= 50000 AND income < 150000",
      "BASIC": "income < 50000"
    },

    "spendBand": {
      "HIGH_SPENDER": "monthly_spend >= 50000",
      "MEDIUM_SPENDER": "monthly_spend >= 20000 AND monthly_spend < 50000",
      "LOW_SPENDER": "monthly_spend < 20000"
    },

    "creditBand": {
      "EXCELLENT": "credit_score >= 750",
      "GOOD": "credit_score >= 650 AND credit_score < 750",
      "POOR": "credit_score < 650"
    }
  },

  "riskWeights": {
    "creditScoreWeight": 1.0,
    "incomeDivisor": 1000,
    "balanceDivisor": 5000
  },

  "riskRules": [

    {
      "riskCategory": "VERY_LOW_RISK",
      "offer": "DIAMOND_CARD",
      "condition": "credit_score >= 800 AND income >= 150000"
    },

    {
      "riskCategory": "LOW_RISK",
      "offer": "PLATINUM_CARD",
      "condition": "credit_score >= 751 AND income >= 100001"
    },

    {
      "riskCategory": "MEDIUM_RISK",
      "offer": "GOLD_CARD",
      "condition": "credit_score >= 650 AND credit_score <= 750"
    },

    {
      "riskCategory": "HIGH_RISK",
      "offer": "SECURED_CARD",
      "condition": "credit_score <= 649"
    }
  ]
}