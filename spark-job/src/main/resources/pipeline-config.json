{
  "datasets": [
    {
      "name": "customer",
      "path": "../sample-data/customer_master.csv"
    },
    {
      "name": "bureau",
      "path": "../sample-data/credit_bureau.csv"
    },
    {
      "name": "transaction",
      "path": "../sample-data/transaction_summary.csv"
    },
    {
      "name": "product",
      "path": "../sample-data/product_holdings.csv"
    },
    {
      "name": "marketing",
      "path": "../sample-data/marketing_preferences.csv"
    }
  ],

  "output": {
    "path": "target/customer-risk-spark-output"
  },

  "joins": [
    {
      "left": "customer",
      "right": "bureau",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "transaction",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "product",
      "column": "customer_id",
      "type": "left"
    },
    {
      "left": "customer",
      "right": "marketing",
      "column": "customer_id",
      "type": "left"
    }
  ],

  "filters": [
    {
      "name": "good_bureau",
      "condition": "credit_score > 700"
    }
  ],

  "attributeRules": {
    "incomeBand": {
      "high": 100000,
      "medium": 50000
    },

    "customerSegment": {
      "premium": 150000,
      "standard": 50000
    },

    "spendBand": {
      "high": 50000,
      "medium": 20000
    },

    "creditBand": {
      "excellent": 750,
      "good": 650
    }
  },

  "riskWeights": {
    "creditScoreWeight": 1.0,
    "incomeDivisor": 1000,
    "balanceDivisor": 5000
  },

  "riskRules": [
    {
      "riskCategory": "LOW_RISK",
      "offer": "PLATINUM_CARD",
      "minCreditScore": 751,
      "minIncome": 100001
    },
    {
      "riskCategory": "MEDIUM_RISK",
      "offer": "GOLD_CARD",
      "minCreditScore": 650,
      "maxCreditScore": 750
    },
    {
      "riskCategory": "HIGH_RISK",
      "offer": "SECURED_CARD",
      "maxCreditScore": 649
    },
    {
      "riskCategory": "VERY_LOW_RISK",
      "offer": "DIAMOND_CARD",
      "minCreditScore": 800,
      "minIncome": 150000
    }
  ]
}